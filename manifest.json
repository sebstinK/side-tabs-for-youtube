{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Side Tabs",
  "version": "1.1.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "Sebastian Kubik",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
